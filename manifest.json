{
  "manifest_version": 3,
  "name": "JUCEES Assistente",
  "short_name": "JUCEES Assistente",
  "version": "1.6.0",
  "minimum_chrome_version": "114",
  "description": "Auxilia CNAEs, respostas de endereço e objetos na Viabilidade do Simplifica/ES, com validação e revisão humana.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://simplifica.es.gov.br/*",
    "https://www.simplifica.es.gov.br/*",
    "https://*.simplifica.es.gov.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir JUCEES Assistente"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://simplifica.es.gov.br/*",
        "https://www.simplifica.es.gov.br/*",
        "https://*.simplifica.es.gov.br/*"
      ],
      "js": [
        "data/cnae-subclasses-2.3.js",
        "lib/cnae.js",
        "lib/privacy.js",
        "lib/run-state.js",
        "lib/performance.js",
        "lib/tab-protection.js",
        "content/cnae-automation.js",
        "content/object-automation.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
